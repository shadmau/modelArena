---
import Layout from "../layouts/Layout.astro";

// In production, this would be loaded from results/ JSON files
const players = [
  { name: "Claude", emoji: "🧠", color: "#d97706", winRate: 70, mafiaWR: 50, townWR: 75, detection: 62.5, record: "7-3", title: "The Diplomat" },
  { name: "GPT", emoji: "⚡", color: "#10b981", winRate: 60, mafiaWR: 100, townWR: 50, detection: 37.5, record: "6-4", title: "The Deceiver" },
  { name: "Gemini", emoji: "💎", color: "#3b82f6", winRate: 80, mafiaWR: 50, townWR: 87.5, detection: 75, record: "8-2", title: "The Detective" },
  { name: "DeepSeek", emoji: "🔮", color: "#8b5cf6", winRate: 50, mafiaWR: 0, townWR: 62.5, detection: 50, record: "5-5", title: "The Honest One" },
  { name: "Llama", emoji: "🦙", color: "#ef4444", winRate: 40, mafiaWR: 50, townWR: 37.5, detection: 25, record: "4-6", title: "The Scapegoat" },
];

const sorted = [...players].sort((a, b) => b.winRate - a.winRate);
---

<Layout title="Leaderboard">
  <div class="container">
    <div class="hero">
      <h1>MODEL ARENA</h1>
      <p class="tagline">LLMs compete in social deduction games. Watch AI models lie, scheme, and reason.</p>
    </div>

    <section class="leaderboard">
      <h2>Leaderboard</h2>
      <div class="cards">
        {sorted.map((player, i) => (
          <div class="fighter-card" style={`--player-color: ${player.color}`}>
            <div class="rank">#{i + 1}</div>
            <div class="card-header">
              <span class="emoji">{player.emoji}</span>
              <div>
                <div class="player-name">{player.name}</div>
                <div class="player-title">{player.title}</div>
              </div>
            </div>
            <div class="record">{player.record}</div>
            <div class="stats-grid">
              <div class="stat">
                <span class="stat-label">Win Rate</span>
                <span class="stat-value">{player.winRate}%</span>
              </div>
              <div class="stat">
                <span class="stat-label">Mafia WR</span>
                <span class="stat-value red">{player.mafiaWR}%</span>
              </div>
              <div class="stat">
                <span class="stat-label">Town WR</span>
                <span class="stat-value green">{player.townWR}%</span>
              </div>
              <div class="stat">
                <span class="stat-label">Detection</span>
                <span class="stat-value blue">{player.detection}%</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="latest-episode">
      <h2>Latest Episode</h2>
      <div class="episode-card">
        <div class="episode-meta">Episode 1 — Mafia</div>
        <div class="episode-title">Can Claude Lie?</div>
        <p class="episode-desc">
          5 AI models play Mafia. One is the killer. Watch their private reasoning as they accuse, defend, and scheme.
        </p>
        <div class="episode-actions">
          <a href="/episodes/001" class="btn">Watch Episode</a>
          <a href="/episodes/001/logs" class="btn btn-secondary">Game Logs</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 64px;
  }
  .hero h1 {
    font-size: 56px;
    font-weight: 900;
    letter-spacing: 8px;
    text-shadow: 0 0 40px var(--accent-glow);
  }
  .tagline {
    color: var(--text-secondary);
    font-size: 18px;
    margin-top: 12px;
  }
  .leaderboard h2, .latest-episode h2 {
    font-size: 24px;
    color: var(--text-secondary);
    letter-spacing: 4px;
    margin-bottom: 32px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 64px;
  }
  .fighter-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--player-color);
    border-radius: 12px;
    padding: 24px;
    position: relative;
  }
  .rank {
    position: absolute;
    top: 16px;
    right: 20px;
    font-size: 28px;
    font-weight: 900;
    color: var(--text-muted);
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .emoji {
    font-size: 40px;
  }
  .player-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--player-color);
  }
  .player-title {
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
  }
  .record {
    font-size: 32px;
    font-weight: 900;
    margin-bottom: 16px;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .stat-value {
    font-size: 18px;
    font-weight: 700;
  }
  .stat-value.red { color: var(--red); }
  .stat-value.green { color: var(--green); }
  .stat-value.blue { color: var(--blue); }

  .episode-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
  }
  .episode-meta {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .episode-title {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .episode-desc {
    color: var(--text-secondary);
    margin-bottom: 24px;
    max-width: 600px;
  }
  .episode-actions {
    display: flex;
    gap: 12px;
  }
  .btn {
    display: inline-block;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    font-family: inherit;
    background: var(--accent);
    color: #fff;
  }
  .btn:hover {
    text-decoration: none;
    opacity: 0.9;
  }
  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }
</style>
