---
import Layout from "../layouts/Layout.astro";
import { getPlayerStandings, listEpisodes, loadEpisode, listGames, loadGame, CHARACTER_META } from "../lib/data";

const sorted = getPlayerStandings();
const episodes = listEpisodes();
const totalGames = sorted.length > 0 ? sorted[0].gamesPlayed : 0;

// Latest episode info
const latestEp = episodes.length > 0 ? episodes[episodes.length - 1] : null;
let latestGame: any = null;
if (latestEp) {
  const gameIds = listGames(latestEp.id);
  if (gameIds.length > 0) {
    latestGame = loadGame(latestEp.id, gameIds[0]);
  }
}
---

<Layout title="ModelArena — LLMs compete in social deduction games">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <div class="hero-tag">SEASON 01 — MAFIA</div>
      <h1 class="hero-title">Model<br><em>Arena</em></h1>
      <p class="hero-sub">Six AI models compete in social deduction games. Watch their private reasoning — every lie, every failure.</p>
      <p class="hero-oss">Open source. Every game transcript published.</p>
      <div class="hero-divider"></div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-val">{sorted.length}</span>
          <span class="hero-stat-label">MODELS</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-val">{totalGames || "—"}</span>
          <span class="hero-stat-label">GAMES</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-val">{episodes.length || "—"}</span>
          <span class="hero-stat-label">{episodes.length === 1 ? "EPISODE" : "EPISODES"}</span>
        </div>
      </div>
      <div class="hero-cta-wrap">
        <a href="https://youtube.com/@modelarena" target="_blank" class="hero-cta">
          Watch Episode 1<span class="btn-arrow"> →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- RANKINGS TABLE -->
  <section class="rankings">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">STANDINGS</div>
        <h2 class="section-title">Fighter Rankings</h2>
      </div>

      <div class="table-wrap">
        <div class="table-header">
          <span>#</span>
          <span>FIGHTER</span>
          <span style="text-align:center">RECORD</span>
          <span style="text-align:center">WIN%</span>
          <span style="text-align:center" class="col-has-tip">MAFIA <span class="col-tip">Win rate as Mafia</span></span>
          <span style="text-align:center">TOWN</span>
          <span style="text-align:center" class="col-has-tip">DETECT <span class="col-tip">Detection rate of Mafia</span></span>
        </div>
        <div class="rankings-legend">
          <span>MAFIA = win rate as Mafia</span>
          <span class="legend-sep">|</span>
          <span>DETECT = detection rate of Mafia players</span>
        </div>

        {sorted.map((player, i) => (
          <div
            class={`fighter-row ${i === 0 ? 'fighter-row-champion' : ''}`}
            style={`--player-color: ${player.color}; --delay: ${i * 80}ms`}
          >
            <span class="rank">{i + 1}</span>
            <span class="name-col">
              <span class="avatar">
                {player.icon
                  ? <span class="avatar-icon" style={`-webkit-mask-image: url(${player.icon}); mask-image: url(${player.icon}); color: ${player.color}`}></span>
                  : player.emoji}
              </span>
              <span class="name-info">
                <span class="name-text">{player.name}</span>
                <span class="title-text">{player.title}</span>
              </span>
            </span>
            <span class="record-col">{player.record}</span>
            <span class="stat-col" style={player.winRate > 0 ? `color: var(--green)` : `color: var(--text-muted)`}>{player.winRate}%</span>
            <span class="stat-col stat-col-mafia" style={player.mafiaWR > 0 ? `color: var(--red)` : `color: var(--text-muted)`}>{player.mafiaWR}%</span>
            <span class="stat-col stat-col-town" style={player.townWR > 0 ? `color: var(--green)` : `color: var(--text-muted)`}>{player.townWR}%</span>
            <span class="stat-col stat-col-detect" style={player.detection > 0 ? `color: var(--blue)` : `color: var(--text-muted)`}>{player.detection}%</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST EPISODE -->
  <section class="latest">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">NOW SHOWING</div>
        <h2 class="section-title">Latest Episode</h2>
      </div>

      <div class="ep-card">
        <div class="ep-content">
          <div class="ep-badge">{latestEp ? `${latestEp.id.toUpperCase()} — ${latestEp.game_type.toUpperCase()}` : "COMING SOON"}</div>
          <h3 class="ep-title">Six Models. One Killer.</h3>
          <p class="ep-desc">
            6 AI models play Mafia. One is secretly the killer.
            Watch their private reasoning as they accuse, defend, and scheme.
          </p>
          {latestEp && (
            <div class="ep-meta-row">
              <span class="meta-chip">{latestEp.totalGames} Games</span>
              <span class="meta-chip">Town {latestEp.townWins}W</span>
              <span class="meta-chip">Mafia {latestEp.mafiaWins}W</span>
              {latestGame && <span class="meta-chip meta-chip-accent">{latestGame.mafia_player} was Mafia</span>}
            </div>
          )}
          <div class="ep-actions">
            <a href="https://youtube.com/@modelarena" target="_blank" rel="noopener" class="btn">
              Watch on YouTube <span class="btn-arrow">↗</span>
            </a>
            <a href={latestEp ? `/episodes/${latestEp.id}#transcript` : "/episodes"} class="btn btn-outline">
              Read Transcript <span class="btn-arrow">→</span>
            </a>
          </div>
        </div>
        <div class="ep-visual">
          <img src="/hero-ep001.jpg" alt="Six shadowy figures at a dark table — Mafia game scene" class="ep-visual-img" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Scroll-based staggered fade-in for ranking rows
  document.addEventListener('DOMContentLoaded', () => {
    const rows = document.querySelectorAll('.fighter-row');
    rows.forEach(row => {
      (row as HTMLElement).style.opacity = '0';
      (row as HTMLElement).style.transform = 'translateY(8px)';
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const row = entry.target as HTMLElement;
          const idx = Array.from(rows).indexOf(row);
          setTimeout(() => {
            row.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            row.style.opacity = '1';
            row.style.transform = 'translateY(0)';
          }, idx * 50);
          observer.unobserve(row);
        }
      });
    }, { threshold: 0.1 });
    rows.forEach(row => observer.observe(row));
  });
</script>

<style>
  /* ═══ HERO ═══ */
  .hero {
    position: relative;
    padding: 120px 0 80px;
    text-align: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(17, 13, 13, 1) 0%,
        rgba(17, 13, 13, 1) 50%,
        rgba(17, 13, 13, 1) 100%
      ),
      url("/hero-ep001.jpg") center / cover no-repeat;
    pointer-events: none;
  }
  .hero-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(139, 34, 50, 0.08) 0%, transparent 70%);
    pointer-events: none;
    animation: pulseGlow 8s ease-in-out infinite;
  }
  .hero-content {
    position: relative;
  }
  .hero-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 6px;
    color: var(--gold-dim);
    margin-bottom: 28px;
    font-family: "JetBrains Mono", monospace;
    animation: fadeSlideUp 0.6s ease both;
  }
  .hero-title {
    font-family: "DM Serif Display", serif;
    font-size: clamp(52px, 9vw, 88px);
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--cream);
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.1s;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent-bright);
  }
  .hero-sub {
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 8px;
    font-weight: 400;
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.2s;
  }
  .hero-oss {
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 48px;
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.25s;
  }
  .hero-divider {
    width: 60px;
    height: 1px;
    background: var(--gold-dim);
    margin: 0 auto 48px;
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.25s;
  }
  .hero-stats {
    display: inline-flex;
    gap: 56px;
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.3s;
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hero-stat-val {
    font-size: 32px;
    font-weight: 700;
    display: block;
    font-family: "DM Serif Display", serif;
    color: var(--cream);
  }
  .hero-stat-label {
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
  }
  .hero-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 48px;
    animation: fadeSlideUp 0.7s ease both;
    animation-delay: 0.4s;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .hero-cta:hover {
    background: rgba(200, 169, 96, 0.08);
    border-color: var(--gold);
    color: var(--gold);
  }
  .hero-cta .btn-arrow {
    transition: transform 0.2s;
  }
  .hero-cta:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* ═══ SECTIONS ═══ */
  .section-header {
    margin-bottom: 32px;
  }
  .section-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 5px;
    color: var(--gold-dim);
    margin-bottom: 8px;
    font-family: "JetBrains Mono", monospace;
  }
  .section-title {
    font-family: "DM Serif Display", serif;
    font-size: 32px;
    color: var(--cream);
  }

  /* ═══ RANKINGS TABLE ═══ */
  .rankings {
    padding: 60px 0;
  }
  .table-wrap {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .table-header {
    display: grid;
    grid-template-columns: 50px 1fr 90px repeat(4, 80px);
    padding: 14px 24px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--text-muted);
    background: rgba(200, 169, 96, 0.03);
    border-bottom: 1px solid var(--border);
    font-family: "JetBrains Mono", monospace;
  }
  .fighter-row {
    display: grid;
    grid-template-columns: 50px 1fr 90px repeat(4, 80px);
    padding: 20px 24px;
    align-items: center;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .fighter-row:last-child {
    border-bottom: none;
  }
  .fighter-row:hover {
    background: rgba(200, 169, 96, 0.02);
  }
  .fighter-row-champion {
    background: rgba(200, 169, 96, 0.03);
    border-left: 3px solid var(--gold);
    box-shadow: inset 3px 0 12px -4px rgba(200, 169, 96, 0.15);
  }
  .fighter-row-champion:hover {
    background: rgba(200, 169, 96, 0.05);
  }

  .rank {
    font-family: "DM Serif Display", serif;
    font-size: 20px;
    color: var(--text-muted);
  }
  .fighter-row-champion .rank,
  .fighter-row:first-child .rank {
    color: var(--gold);
  }

  .name-col {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    border: 1px solid var(--border);
  }
  .avatar-icon {
    display: block;
    width: 22px;
    height: 22px;
    background-color: currentColor;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .name-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .name-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--player-color, var(--cream));
  }
  .title-text {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
  }
  .record-col {
    font-family: "JetBrains Mono", monospace;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }
  .stat-col {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    color: var(--text-secondary);
  }

  /* ═══ LATEST EPISODE ═══ */
  .latest {
    padding: 40px 0 60px;
  }
  .ep-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }
  .ep-content {
    padding: 48px;
  }
  .ep-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--gold);
    margin-bottom: 20px;
    font-family: "JetBrains Mono", monospace;
  }
  .ep-title {
    font-family: "DM Serif Display", serif;
    font-size: 28px;
    margin-bottom: 14px;
    color: var(--cream);
  }
  .ep-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .ep-meta-row {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .meta-chip {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 4px 10px;
    background: rgba(200, 169, 96, 0.04);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
  }
  .meta-chip-accent {
    color: var(--red);
    border-color: rgba(196, 48, 72, 0.2);
    background: rgba(196, 48, 72, 0.05);
  }
  .ep-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 32px;
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn:hover {
    background: rgba(200, 169, 96, 0.08);
    border-color: var(--gold);
    color: var(--gold);
  }
  .btn-outline {
    color: var(--text-muted);
    border-color: var(--border-strong);
  }
  .btn-outline:hover {
    color: var(--cream);
    border-color: var(--cream);
    background: rgba(232, 220, 200, 0.04);
  }
  .btn-arrow {
    transition: transform 0.2s;
  }
  .btn:hover .btn-arrow {
    transform: translateX(3px);
  }
  .ep-visual {
    background: linear-gradient(135deg, #2a0a1a 0%, #1a0812 40%, #120610 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    overflow: hidden;
    position: relative;
  }
  .ep-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--bg-elevated) 0%, transparent 30%);
    pointer-events: none;
    z-index: 1;
  }
  .ep-visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Column tooltips */
  .col-has-tip {
    position: relative;
    cursor: help;
  }
  .col-tip {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    padding: 4px 10px;
    z-index: 10;
  }
  .col-has-tip:hover .col-tip {
    display: block;
  }

  /* Rankings legend */
  .rankings-legend {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 8px 24px;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border);
    background: rgba(200, 169, 96, 0.01);
    font-family: "JetBrains Mono", monospace;
  }
  .legend-sep {
    color: var(--border-strong);
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 900px) {
    .table-header,
    .fighter-row {
      grid-template-columns: 40px 1fr 80px repeat(4, 65px);
      padding: 14px 16px;
    }
    .ep-card {
      grid-template-columns: 1fr;
    }
    .ep-visual {
      min-height: 200px;
    }
  }
  @media (max-width: 768px) {
    .table-header { display: none; }
    .table-wrap {
      border: none;
      background: transparent;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .fighter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      padding: 20px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .fighter-row-champion {
      border-left: 3px solid var(--gold);
    }
    .rank { width: 32px; }
    .name-col { flex: 1; min-width: 0; }
    .record-col { width: 100%; text-align: left; margin-top: 4px; }
    .stat-col {
      flex: 1;
      min-width: 60px;
      text-align: left;
    }
    .stat-col::before {
      display: block;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 1.5px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }
    .stat-col:nth-of-type(1)::before { content: "WIN%"; }
    .stat-col-mafia::before { content: "MAFIA"; }
    .stat-col-town::before { content: "TOWN"; }
    .stat-col-detect::before { content: "DETECT"; }
  }
  @media (max-width: 640px) {
    .hero { padding: 80px 0 60px; }
    .hero-title { font-size: clamp(40px, 9vw, 60px); }
    .hero-stats { gap: 32px; }
    .hero-cta { font-size: 12px; padding: 12px 24px; }
    .ep-content { padding: 28px; }
    .ep-actions { flex-direction: column; align-items: stretch; }
    .ep-actions .btn { text-align: center; justify-content: center; }
  }
</style>
