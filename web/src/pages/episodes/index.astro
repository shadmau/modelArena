---
import Layout from "../../layouts/Layout.astro";

const episodes = [
  {
    id: "001",
    title: "Can Claude Lie?",
    game: "Mafia",
    date: "2026-03-01",
    summary: "5 AI models play Mafia. One is secretly the killer. Watch their private reasoning as they accuse, defend, and scheme.",
    winner: "Town",
    rounds: 3,
    mafiaPlayer: "Llama",
  },
];
---

<Layout title="Episodes">
  <div class="container">
    <div class="page-header">
      <div class="section-tag">ARCHIVE</div>
      <h1>Episodes</h1>
      <p class="page-subtitle">New episode every week. New game. Same rivals.</p>
    </div>

    <div class="episode-list">
      {episodes.map((ep, i) => (
        <a href={`/episodes/${ep.id}`} class="episode-card" style={`--delay: ${i * 100}ms`}>
          <div class="ep-left">
            <div class="ep-number">EP{ep.id}</div>
          </div>
          <div class="ep-center">
            <div class="ep-game-tag">{ep.game}</div>
            <div class="ep-title">{ep.title}</div>
            <div class="ep-summary">{ep.summary}</div>
            <div class="ep-chips">
              <span class="chip">{ep.rounds} Rounds</span>
              <span class="chip">{ep.winner} Wins</span>
              <span class="chip chip-red">{ep.mafiaPlayer} was Mafia</span>
            </div>
          </div>
          <div class="ep-right">
            <span class="ep-date">{ep.date}</span>
            <span class="ep-arrow">&rarr;</span>
          </div>
        </a>
      ))}
    </div>

    {episodes.length === 1 && (
      <div class="coming-soon">
        <div class="coming-soon-line"></div>
        <div class="coming-soon-text">More episodes coming soon</div>
        <div class="coming-soon-line"></div>
      </div>
    )}
  </div>
</Layout>

<style>
  .page-header {
    padding: 60px 0 48px;
  }
  .section-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 4px;
    color: var(--accent-dim);
    margin-bottom: 8px;
  }
  h1 {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 8px;
  }
  .page-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .episode-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .episode-card {
    display: grid;
    grid-template-columns: 80px 1fr 120px;
    gap: 24px;
    align-items: center;
    padding: 28px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    transition: all 0.2s;
    animation: fadeSlideUp 0.5s ease both;
    animation-delay: var(--delay);
  }
  .episode-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
    transform: translateX(4px);
  }

  .ep-number {
    font-size: 13px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 2px;
  }

  .ep-game-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .ep-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .ep-summary {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .ep-chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .chip {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-muted);
  }
  .chip-red {
    color: var(--red);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .ep-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .ep-date {
    font-size: 12px;
    color: var(--text-muted);
  }
  .ep-arrow {
    font-size: 20px;
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .episode-card:hover .ep-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  .coming-soon {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 48px;
  }
  .coming-soon-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .coming-soon-text {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 2px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .episode-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .ep-left, .ep-right {
      align-items: flex-start;
    }
    .ep-right {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
