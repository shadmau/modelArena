---
import Layout from "../../layouts/Layout.astro";
import { listEpisodes, loadStats } from "../../lib/data";

const episodes = listEpisodes();

// Enrich with stats
const enriched = episodes.map(ep => {
  const stats = loadStats(ep.id);
  return {
    ...ep,
    stats,
  };
}).reverse(); // newest first
---

<Layout title="Episodes">
  <div class="container">
    <div class="page-header">
      <div class="section-tag">ARCHIVE</div>
      <h1>Episodes</h1>
      <p class="page-subtitle">New episode every week. New game. Same rivals.</p>
    </div>

    {enriched.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">&#9654;</div>
        <div class="empty-text">No episodes yet. Run the first game with:</div>
        <code class="empty-code">./produce-episode.sh ep001 10</code>
      </div>
    ) : (
      <div class="episode-list">
        {enriched.map((ep, i) => (
          <a href={`/episodes/${ep.id}`} class="episode-card" style={`--delay: ${i * 100}ms`}>
            <div class="ep-left">
              <div class="ep-number">{ep.id.toUpperCase()}</div>
            </div>
            <div class="ep-center">
              <div class="ep-game-tag">{ep.game_type.toUpperCase()}</div>
              <div class="ep-title">{ep.title}</div>
              <div class="ep-chips">
                <span class="chip">{ep.totalGames} Games</span>
                <span class="chip">Town {ep.townWins}W</span>
                <span class="chip">Mafia {ep.mafiaWins}W</span>
              </div>
            </div>
            <div class="ep-right">
              <span class="ep-date">{ep.timestamp?.split("T")[0] || ""}</span>
              <span class="ep-arrow">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .page-header {
    padding: 60px 0 48px;
  }
  .section-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 4px;
    color: var(--accent-dim);
    margin-bottom: 8px;
  }
  h1 {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 8px;
  }
  .page-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .empty-state {
    text-align: center;
    padding: 80px 0;
  }
  .empty-icon {
    font-size: 36px;
    color: var(--text-muted);
    opacity: 0.3;
    margin-bottom: 20px;
  }
  .empty-text {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .empty-code {
    font-size: 13px;
    color: var(--accent);
    background: var(--bg-card);
    padding: 8px 16px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .episode-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .episode-card {
    display: grid;
    grid-template-columns: 80px 1fr 120px;
    gap: 24px;
    align-items: center;
    padding: 28px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    transition: all 0.2s;
    animation: fadeSlideUp 0.5s ease both;
    animation-delay: var(--delay);
  }
  .episode-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
    transform: translateX(4px);
  }

  .ep-number {
    font-size: 13px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 2px;
  }
  .ep-game-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .ep-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .ep-chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .chip {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text-muted);
  }

  .ep-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .ep-date {
    font-size: 12px;
    color: var(--text-muted);
  }
  .ep-arrow {
    font-size: 20px;
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .episode-card:hover .ep-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .episode-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .ep-right {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
