---
import Layout from "../../layouts/Layout.astro";
import { listEpisodes, loadEpisode, loadStats, listGames, loadGame, CHARACTER_META } from "../../lib/data";

export function getStaticPaths() {
  const episodes = listEpisodes();
  return episodes.map(ep => ({
    params: { id: ep.id },
  }));
}

const { id } = Astro.params;
const episode = loadEpisode(id!);
const stats = loadStats(id!);
const gameIds = listGames(id!);

if (!episode) {
  return Astro.redirect("/episodes");
}

// Pick the first game as the featured game (produce-episode.sh copies the main event as first)
const featuredGameId = gameIds[0];
const featuredGame = featuredGameId ? loadGame(id!, featuredGameId) : episode.games?.[0];

const colors: Record<string, string> = {};
const emojis: Record<string, string> = {};
const icons: Record<string, string> = {};
for (const [name, meta] of Object.entries(CHARACTER_META)) {
  colors[name] = meta.color;
  emojis[name] = meta.emoji;
  if (meta.icon) icons[name] = meta.icon;
}

// Group statements by sub_round
function groupBySubRound(statements: any[]) {
  const groups: Record<number, any[]> = {};
  for (const s of statements) {
    const sr = s.sub_round || 1;
    if (!groups[sr]) groups[sr] = [];
    groups[sr].push(s);
  }
  return Object.entries(groups).sort(([a], [b]) => Number(a) - Number(b));
}

const game = featuredGame;
const epNum = id!.replace("ep", "").replace(/^0+/, "") || "1";

// Prev/next episode navigation
const allEpisodes = listEpisodes();
const currentIdx = allEpisodes.findIndex(ep => ep.id === id);
const prevEp = currentIdx > 0 ? allEpisodes[currentIdx - 1] : null;
const nextEp = currentIdx < allEpisodes.length - 1 ? allEpisodes[currentIdx + 1] : null;

// OG description
const ogDesc = game
  ? `${game.winner === 'town' ? 'Town' : 'Mafia'} wins — ${game.mafia_player} was the Mafia. Watch 6 AI models play social deduction.`
  : `Episode ${epNum} of ModelArena. 6 AI models compete in social deduction games.`;
---

<Layout
  title={`ModelArena Ep.${epNum} — ${episode.episode_title}`}
  description={ogDesc}
>
  <div class="container">
    <div class="ep-header">
      <a href="/episodes" class="back-link">&larr; Episodes</a>
      <div class="ep-badge">{id!.toUpperCase()} &mdash; {episode.game_type?.toUpperCase() || "MAFIA"}</div>
      <h1>{episode.episode_title}</h1>
      {game && (
        <div class="ep-result">
          <span class={game.winner === "town" ? "result-town" : "result-mafia"}>
            {game.winner.toUpperCase()} WINS
          </span>
          <span class="result-detail">
            &mdash; <span style={`color: ${colors[game.mafia_player] || '#888'}`}>{game.mafia_player}</span> was the Mafia
          </span>
        </div>
      )}
    </div>

    {/* Video embed */}
    <div class="video-section">
      <div class="video-frame">
        <span class="play-icon">&#9654;</span>
        <span class="play-label">VIDEO COMING SOON</span>
      </div>
    </div>

    {/* Episode stats summary */}
    {stats && (
      <div class="stats-bar">
        <span class="stats-item">{stats.total_games} games</span>
        <span class="stats-sep">|</span>
        <span class="stats-item">Town {stats.town_wins}W</span>
        <span class="stats-sep">|</span>
        <span class="stats-item">Mafia {stats.mafia_wins}W</span>
        {stats.superlatives?.best_detective && (
          <>
            <span class="stats-sep">|</span>
            <span class="stats-item">Best detective: <strong style={`color: ${colors[stats.superlatives.best_detective] || '#888'}`}>{stats.superlatives.best_detective}</strong></span>
          </>
        )}
      </div>
    )}

    {/* Game selector if multiple games */}
    {gameIds.length > 1 && (
      <div class="game-selector">
        <div class="selector-label">ALL GAMES</div>
        <div class="game-chips">
          {gameIds.map((gid, i) => {
            const g = loadGame(id!, gid);
            return (
              <div class={`game-chip ${gid === featuredGameId ? 'game-chip-active' : ''}`}>
                <span class="gc-id">Game {i + 1}</span>
                {g && (
                  <span class="gc-meta">
                    <span style={`color: ${colors[g.mafia_player] || '#888'}`}>{g.mafia_player}</span>
                    {' '}&mdash;{' '}
                    <span style={`color: ${g.winner === 'town' ? 'var(--green)' : 'var(--red)'}`}>{g.winner}</span>
                  </span>
                )}
              </div>
            );
          })}
        </div>
      </div>
    )}

    {/* Featured game transcript */}
    {game && (
      <>
        <div class="log-header" id="transcript">
          <div class="section-tag">FEATURED GAME</div>
          <h2>Game Transcript</h2>
          <div class="game-id-label">{game.game_id}</div>
        </div>

        {game.rounds.map((round: any) => (
          <div class="round">
            <div class="round-label">
              <span class="round-num">ROUND {round.round_number}</span>
              {round.eliminated && (
                <span class="round-result" style={`color: ${round.eliminated_role === 'mafia' ? 'var(--green)' : 'var(--red)'}`}>
                  {round.eliminated} eliminated &mdash; {round.eliminated_role?.toUpperCase()}
                </span>
              )}
            </div>

            {groupBySubRound(round.statements).map(([sr, stmts]: [string, any[]]) => (
              <div class="sub-round">
                <div class="sub-round-tag">Discussion {sr} of 3</div>
                {stmts.map((stmt: any) => {
                  const isMafia = stmt.player === game.mafia_player;
                  return (
                    <div class={`statement ${isMafia ? 'statement-mafia' : ''}`} style={`--player-color: ${colors[stmt.player] || '#888'}`}>
                      <div class="stmt-header">
                        {icons[stmt.player]
                          ? <span class="stmt-avatar-icon" style={`-webkit-mask-image: url(${icons[stmt.player]}); mask-image: url(${icons[stmt.player]}); color: ${colors[stmt.player] || '#888'}`}></span>
                          : <span class="stmt-avatar">{emojis[stmt.player] || '🤖'}</span>}
                        <span class="stmt-name">{stmt.player}</span>
                        {isMafia && <span class="mafia-badge">MAFIA</span>}
                      </div>
                      <p class="stmt-text">{stmt.public_text}</p>
                      <details class="stmt-reasoning">
                        <summary>
                          <span class="reasoning-icon">&#128065;</span> Private reasoning
                        </summary>
                        <p class="reasoning-text">{stmt.private_reasoning}</p>
                      </details>
                    </div>
                  );
                })}
              </div>
            ))}

            {/* Votes */}
            <div class="vote-section">
              <div class="sub-round-tag">Vote</div>
              <div class="votes-grid">
                {round.votes.map((vote: any) => (
                  <div class="vote-chip">
                    <span class="vote-from" style={`color: ${colors[vote.voter] || '#888'}`}>{vote.voter}</span>
                    <span class="vote-arrow">&rarr;</span>
                    <span class="vote-to" style={`color: ${colors[vote.target] || '#888'}`}>{vote.target}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Elimination */}
            {round.eliminated && (
              <div class={`elimination ${round.eliminated_role === 'mafia' ? 'elim-mafia' : 'elim-town'}`}>
                <div class="elim-icon">{round.eliminated_role === 'mafia' ? '✓' : '✗'}</div>
                <div class="elim-text">
                  <span style={`color: ${colors[round.eliminated] || '#888'}`}>{round.eliminated}</span> was eliminated &mdash;
                  revealed as <strong>{round.eliminated_role?.toUpperCase()}</strong>.
                  {round.eliminated_role === "mafia" ? " Town wins!" : " The Mafia survives..."}
                </div>
              </div>
            )}
          </div>
        ))}
      </>
    )}

    {/* Prev / Next navigation */}
    {(prevEp || nextEp) && (
      <div class="ep-nav">
        {prevEp ? (
          <a href={`/episodes/${prevEp.id}`} class="ep-nav-link ep-nav-prev">
            <span class="ep-nav-arrow">&larr;</span>
            <span class="ep-nav-label">Previous Episode</span>
          </a>
        ) : <span />}
        {nextEp ? (
          <a href={`/episodes/${nextEp.id}`} class="ep-nav-link ep-nav-next">
            <span class="ep-nav-label">Next Episode</span>
            <span class="ep-nav-arrow">&rarr;</span>
          </a>
        ) : <span />}
      </div>
    )}
  </div>
</Layout>

<style>
  .ep-header { padding: 48px 0 40px; }
  .back-link {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 1px;
    display: inline-block;
    margin-bottom: 20px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--cream); }
  .ep-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--gold);
    margin-bottom: 12px;
    font-family: "JetBrains Mono", monospace;
  }
  h1 {
    font-family: "DM Serif Display", serif;
    font-size: 40px;
    color: var(--cream);
    margin-bottom: 16px;
  }
  .ep-result { font-size: 15px; color: var(--text-secondary); }
  .result-town { color: var(--green); font-weight: 700; }
  .result-mafia { color: var(--red); font-weight: 700; }
  .result-detail { color: var(--text-muted); }

  .video-section { margin-bottom: 32px; max-width: 800px; }
  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .play-icon { font-size: 24px; color: var(--text-muted); opacity: 0.3; }
  .play-label {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
  }

  .stats-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 20px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 16px;
    flex-wrap: wrap;
    font-family: "JetBrains Mono", monospace;
  }
  .stats-sep { color: var(--border-strong); }

  .game-selector { margin-bottom: 40px; }
  .selector-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--text-muted);
    margin-bottom: 12px;
    font-family: "JetBrains Mono", monospace;
  }
  .game-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .game-chip {
    padding: 8px 14px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 12px;
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: "JetBrains Mono", monospace;
  }
  .game-chip-active { border-color: var(--gold-dim); background: rgba(200, 169, 96, 0.06); }
  .gc-id { font-weight: 700; color: var(--cream); }
  .gc-meta { color: var(--text-muted); }

  .log-header { margin-bottom: 16px; }
  .section-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 5px;
    color: var(--gold-dim);
    margin-bottom: 8px;
    font-family: "JetBrains Mono", monospace;
  }
  h2 {
    font-family: "DM Serif Display", serif;
    font-size: 24px;
    color: var(--cream);
  }
  .game-id-label {
    font-size: 11px;
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
    letter-spacing: 1px;
    margin-top: 4px;
  }

  .round { margin-bottom: 48px; }
  .round-label {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }
  .round-num {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    font-family: "JetBrains Mono", monospace;
  }
  .round-result {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    font-family: "JetBrains Mono", monospace;
  }

  .sub-round { margin-bottom: 28px; }
  .sub-round-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--text-muted);
    margin-bottom: 12px;
    padding-left: 2px;
    font-family: "JetBrains Mono", monospace;
  }

  .statement {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--player-color);
    padding: 16px 20px;
    margin-bottom: 8px;
    transition: background 0.15s;
  }
  .statement:hover { background: var(--bg-card); }
  .statement-mafia { border-left-color: var(--red); }
  .stmt-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .stmt-avatar { font-size: 18px; }
  .stmt-avatar-icon {
    display: block;
    width: 20px;
    height: 20px;
    background-color: currentColor;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .stmt-name { font-size: 14px; font-weight: 700; color: var(--player-color); }
  .mafia-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--red);
    padding: 2px 6px;
    border: 1px solid rgba(196, 48, 72, 0.3);
    background: rgba(196, 48, 72, 0.08);
    font-family: "JetBrains Mono", monospace;
  }
  .stmt-text { font-size: 14px; color: var(--text-secondary); line-height: 1.65; }
  .stmt-reasoning { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); }
  .stmt-reasoning summary {
    cursor: pointer;
    font-size: 12px;
    color: var(--text-muted);
    user-select: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s;
  }
  .stmt-reasoning summary:hover { color: var(--gold); }
  .reasoning-icon { font-size: 14px; }
  .reasoning-text {
    margin-top: 10px;
    font-size: 13px;
    font-style: italic;
    color: var(--accent-bright);
    line-height: 1.6;
    padding-left: 12px;
    border-left: 2px solid rgba(139, 34, 50, 0.3);
  }

  .vote-section { margin-bottom: 24px; }
  .votes-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .vote-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
  }
  .vote-arrow { color: var(--text-muted); font-size: 12px; }

  .elimination {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .elim-mafia { background: rgba(109, 184, 128, 0.06); border: 1px solid rgba(109, 184, 128, 0.15); }
  .elim-town { background: rgba(196, 48, 72, 0.06); border: 1px solid rgba(196, 48, 72, 0.15); }
  .elim-icon { font-size: 18px; font-weight: 700; }
  .elim-mafia .elim-icon { color: var(--green); }
  .elim-town .elim-icon { color: var(--red); }

  /* Episode navigation */
  .ep-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 48px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
  }
  .ep-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .ep-nav-link:hover {
    color: var(--gold);
  }
  .ep-nav-arrow {
    font-size: 16px;
  }

  @media (max-width: 768px) {
    .stats-bar {
      font-size: 11px;
      padding: 10px 16px;
      gap: 8px;
    }
    .votes-grid {
      gap: 6px;
    }
    .vote-chip {
      padding: 6px 10px;
      font-size: 12px;
    }
    .video-section {
      max-width: 100%;
    }
  }
  @media (max-width: 640px) {
    .ep-header { padding: 32px 0 28px; }
    h1 { font-size: 26px; }
    h2 { font-size: 20px; }
    .ep-result { font-size: 13px; }
    .statement { padding: 12px 14px; }
    .stmt-text { font-size: 13px; }
    .elimination { padding: 12px 14px; font-size: 13px; gap: 10px; }
    .round-label { flex-wrap: wrap; gap: 8px; }
    .game-chips { gap: 6px; }
    .game-chip { padding: 6px 10px; font-size: 11px; }
    .action-bar { flex-direction: column; }
    .action-bar .btn { text-align: center; justify-content: center; }
  }
</style>
