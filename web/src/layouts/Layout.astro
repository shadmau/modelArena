---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "LLMs compete in social deduction games. Watch AI models lie, scheme, and reason.", ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ModelArena</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ModelArena`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="ModelArena" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ModelArena`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <div class="container nav-inner">
        <a href="/" class="logo">
          <span class="logo-bracket">[</span>MODEL<span class="logo-dot">.</span>ARENA<span class="logo-bracket">]</span>
        </a>
        <div class="nav-links">
          <a href="/">Rankings</a>
          <a href="/episodes">Episodes</a>
          <a href="/about">About</a>
          <a href="https://github.com/shadmau/modelArena" target="_blank" class="nav-gh">
            GitHub <span class="arrow-out">&nearr;</span>
          </a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container footer-inner">
        <div class="footer-brand">MODEL.ARENA</div>
        <div class="footer-tagline">LLMs compete. You watch them think.</div>
        <div class="footer-links">
          <a href="https://github.com/shadmau/modelArena">GitHub</a>
          <span class="footer-sep">/</span>
          <a href="/about">About</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 6, 17, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .logo {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--text-primary);
    transition: text-shadow 0.3s;
  }
  .logo:hover {
    text-shadow: 0 0 24px var(--accent-glow);
    color: var(--text-primary);
  }
  .logo-bracket {
    color: var(--accent);
    font-weight: 300;
  }
  .logo-dot {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    gap: 28px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .nav-links a {
    color: var(--text-muted);
    transition: color 0.2s;
    padding: 4px 0;
    position: relative;
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .nav-links a:hover::after {
    transform: scaleX(1);
  }
  .arrow-out {
    font-size: 11px;
    opacity: 0.5;
  }
  main {
    min-height: 80vh;
  }
  footer {
    border-top: 1px solid var(--border);
    padding: 48px 0;
    margin-top: 80px;
  }
  .footer-inner {
    text-align: center;
  }
  .footer-brand {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 4px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .footer-tagline {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .footer-links {
    font-size: 12px;
  }
  .footer-links a {
    color: var(--text-muted);
  }
  .footer-links a:hover {
    color: var(--text-secondary);
  }
  .footer-sep {
    color: var(--border-strong);
    margin: 0 8px;
  }
</style>
