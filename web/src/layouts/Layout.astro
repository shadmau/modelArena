---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "LLMs compete in social deduction games. Watch their private reasoning — every lie, every failure. Open source.", ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : new URL("/og.png", Astro.site);
const fullTitle = title.includes("ModelArena") ? title : `${title} | ModelArena`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="ModelArena" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=General+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <div class="container nav-inner">
        <a href="/" class="logo">
          <img src="/logo.svg" alt="ModelArena" class="logo-icon" />
          <span class="logo-text">Model<em class="logo-accent">Arena</em></span>
        </a>
        <button class="nav-toggle" aria-label="Toggle menu">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <div class="nav-links">
          <a href="/">Rankings</a>
          <a href="/episodes">Episodes</a>
          <a href="/episodes/ep001#transcript">Transcript</a>
          <a href="/about">About</a>
          <a href="https://github.com/shadmau/modelArena" target="_blank" class="nav-gh">
            GitHub <span class="arrow-out">&nearr;</span>
          </a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container footer-inner">
        <div class="footer-brand">ModelArena</div>
        <div class="footer-tagline">LLMs compete. You watch them think.</div>
        <div class="footer-links">
          <a href="https://github.com/shadmau/modelArena" target="_blank">GitHub</a>
          <span class="footer-sep">/</span>
          <a href="https://www.youtube.com/@ModelArenaTV" target="_blank">YouTube</a>
          <span class="footer-sep">/</span>
          <a href="https://x.com/ModelArenaTV" target="_blank">X</a>
          <span class="footer-sep">/</span>
          <a href="/about">About</a>
        </div>
        <div class="footer-license">MIT Licensed</div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.querySelector('.nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', () => links.classList.toggle('open'));
        links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => links.classList.remove('open')));
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(17, 13, 13, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity 0.2s;
  }
  .logo:hover {
    opacity: 0.85;
  }
  .logo-icon {
    width: 28px;
    height: 28px;
  }
  .logo-text {
    font-family: "DM Serif Display", serif;
    font-size: 20px;
    color: var(--cream);
    letter-spacing: 2px;
  }
  .logo-accent {
    color: var(--gold);
    font-style: italic;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .nav-links a {
    color: var(--text-muted);
    transition: color 0.2s;
    padding: 4px 0;
    position: relative;
  }
  .nav-links a:hover {
    color: var(--cream);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gold-dim);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .nav-links a:hover::after {
    transform: scaleX(1);
  }
  .arrow-out {
    font-size: 11px;
    opacity: 0.5;
  }
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    flex-direction: column;
    gap: 5px;
  }
  .nav-toggle-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-muted);
    transition: all 0.2s;
  }
  main {
    min-height: 80vh;
  }
  footer {
    border-top: 1px solid var(--border);
    padding: 56px 0;
    margin-top: 80px;
  }
  .footer-inner {
    text-align: center;
  }
  .footer-brand {
    font-family: "DM Serif Display", serif;
    font-size: 14px;
    color: var(--text-muted);
    letter-spacing: 3px;
    margin-bottom: 8px;
  }
  .footer-tagline {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .footer-links {
    font-size: 12px;
  }
  .footer-links a {
    color: var(--text-muted);
  }
  .footer-links a:hover {
    color: var(--cream);
  }
  .footer-sep {
    color: var(--border-strong);
    margin: 0 8px;
  }
  .footer-license {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 16px;
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 16px;
      font-size: 12px;
    }
  }
  @media (max-width: 640px) {
    .nav-inner {
      height: 56px;
      position: relative;
    }
    .nav-toggle {
      display: flex;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(17, 13, 13, 0.97);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      flex-direction: column;
      gap: 0;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      padding: 12px 32px;
    }
    .nav-links a::after {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .container {
      padding: 0 16px;
    }
  }
</style>
